<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Amit Maahal — Professional Resume | Senior Web Designer &amp; WordPress Developer</title>
  
  <!-- Google Fonts Preconnect & Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --primary: #7c3aed;
      --primary-dark: #6d28d9;
      --primary-light: #f5f3ff;
      --secondary: #0284c7;
      --accent: #06b6d4;
      --dark: #0f172a;
      --text: #334155;
      --text-muted: #64748b;
      --text-light: #94a3b8;
      --border: #e2e8f0;
      --bg-page: #f8fafc;
      --bg-card: #ffffff;
      --success: #10b981;
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
      --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.08), 0 2px 4px -2px rgba(0,0,0,0.05);
      --shadow-lg: 0 10px 25px -5px rgba(0,0,0,0.08), 0 8px 10px -6px rgba(0,0,0,0.04);
      --radius: 12px;
      --radius-sm: 8px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      line-height: 1.6;
      color: var(--text);
      background-color: var(--bg-page);
      padding: 30px 16px 60px;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* Screen Action Header Bar */
    .action-bar {
      max-width: 960px;
      margin: 0 auto 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 18px;
      font-size: 0.9rem;
      font-weight: 600;
      border-radius: 9999px;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.2s ease;
      border: 1px solid transparent;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(124, 58, 237, 0.25);
    }

    .btn-primary:hover {
      box-shadow: 0 6px 16px rgba(124, 58, 237, 0.35);
      transform: translateY(-1px);
    }

    .btn-outline {
      background: #ffffff;
      color: var(--dark);
      border-color: var(--border);
      box-shadow: var(--shadow-sm);
    }

    .btn-outline:hover {
      background: #f1f5f9;
      border-color: #cbd5e1;
    }

    /* Resume Document Wrapper */
    .resume-wrapper {
      max-width: 960px;
      margin: 0 auto;
      background: var(--bg-card);
      border-radius: var(--radius);
      box-shadow: var(--shadow-lg);
      border: 1px solid var(--border);
      overflow: hidden;
    }

    /* Header Banner */
    .resume-header {
      background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 60%, #31104b 100%);
      color: #ffffff;
      padding: 40px 44px 34px;
      position: relative;
    }

    .resume-header::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--primary), var(--secondary), var(--accent));
    }

    .header-content {
      display: flex;
      align-items: center;
      gap: 28px;
      flex-wrap: wrap;
    }

    .avatar-box {
      width: 104px;
      height: 104px;
      border-radius: 24px;
      padding: 3px;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      flex-shrink: 0;
      box-shadow: 0 8px 20px rgba(0,0,0,0.3);
    }

    .avatar-img {
      width: 100%;
      height: 100%;
      border-radius: 21px;
      object-fit: cover;
      display: block;
      background: #1e293b;
    }

    .header-details {
      flex: 1;
      min-width: 280px;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 10px;
      border-radius: 9999px;
      background: rgba(16, 185, 129, 0.16);
      color: #34d399;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      margin-bottom: 8px;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #34d399;
      box-shadow: 0 0 8px #34d399;
    }

    .name-title {
      font-family: 'Outfit', sans-serif;
      font-size: 2.25rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #ffffff;
      line-height: 1.15;
      margin-bottom: 6px;
    }

    .role-title {
      font-size: 1.1rem;
      font-weight: 600;
      color: #cbd5e1;
      margin-bottom: 14px;
    }

    .role-title span {
      color: #a78bfa;
    }

    .contact-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 14px 20px;
      font-size: 0.85rem;
      color: #94a3b8;
    }

    .contact-item {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      color: #e2e8f0;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .contact-item:hover {
      color: #38bdf8;
    }

    .contact-item svg {
      width: 16px;
      height: 16px;
      color: #a78bfa;
      flex-shrink: 0;
    }

    /* Key Stats Bar */
    .metrics-bar {
      background: #f1f5f9;
      border-bottom: 1px solid var(--border);
      padding: 14px 44px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 16px;
    }

    .metric-item {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .metric-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--primary);
      box-shadow: var(--shadow-sm);
      flex-shrink: 0;
    }

    .metric-val {
      font-family: 'Outfit', sans-serif;
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--dark);
      line-height: 1.2;
    }

    .metric-lbl {
      font-size: 0.75rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 600;
    }

    /* Two-Column Body Grid */
    .resume-body {
      display: grid;
      grid-template-columns: 340px 1fr;
      padding: 36px 44px 44px;
      gap: 38px;
    }

    @media (max-width: 820px) {
      .resume-body {
        grid-template-columns: 1fr;
        padding: 24px;
        gap: 30px;
      }
      .resume-header {
        padding: 28px 24px;
      }
      .metrics-bar {
        padding: 14px 24px;
      }
    }

    /* Section Typography */
    .section-heading {
      font-family: 'Outfit', sans-serif;
      font-size: 1rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--dark);
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 18px;
      padding-bottom: 8px;
      border-bottom: 2px solid var(--border);
      position: relative;
    }

    .section-heading::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 44px;
      height: 2px;
      background: var(--primary);
    }

    .section-heading svg {
      width: 18px;
      height: 18px;
      color: var(--primary);
    }

    .sidebar-section {
      margin-bottom: 28px;
    }

    /* Summary Section */
    .summary-text {
      font-size: 0.95rem;
      color: var(--text);
      line-height: 1.7;
      margin-bottom: 28px;
      background: #faf5ff;
      border-left: 3px solid var(--primary);
      padding: 14px 18px;
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    }

    /* Timeline Items */
    .timeline {
      display: flex;
      flex-direction: column;
      gap: 22px;
      margin-bottom: 28px;
    }

    .timeline-item {
      position: relative;
      padding-left: 20px;
      border-left: 2px solid #e2e8f0;
    }

    .timeline-item::before {
      content: '';
      position: absolute;
      left: -6px;
      top: 5px;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--primary);
      border: 2px solid #ffffff;
      box-shadow: 0 0 0 2px rgba(124, 58, 237, 0.2);
    }

    .timeline-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 4px;
      margin-bottom: 4px;
    }

    .timeline-title {
      font-size: 1.02rem;
      font-weight: 700;
      color: var(--dark);
    }

    .timeline-date {
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--primary);
      background: var(--primary-light);
      padding: 2px 8px;
      border-radius: 9999px;
    }

    .timeline-company {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--secondary);
      margin-bottom: 8px;
    }

    .timeline-desc {
      font-size: 0.88rem;
      color: var(--text);
      line-height: 1.6;
      margin-bottom: 8px;
    }

    .timeline-bullets {
      list-style: none;
      padding-left: 0;
      display: flex;
      flex-direction: column;
      gap: 5px;
      font-size: 0.86rem;
    }

    .timeline-bullets li {
      position: relative;
      padding-left: 16px;
      color: var(--text);
    }

    .timeline-bullets li::before {
      content: '▹';
      position: absolute;
      left: 0;
      color: var(--primary);
      font-size: 0.95rem;
    }

    /* Projects Spotlight */
    .project-mini-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 14px;
      margin-bottom: 28px;
    }

    .project-mini-card {
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 14px;
      transition: all 0.2s ease;
    }

    .project-mini-title {
      font-size: 0.92rem;
      font-weight: 700;
      color: var(--dark);
      margin-bottom: 4px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .project-mini-tag {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--secondary);
      text-transform: uppercase;
    }

    .project-mini-desc {
      font-size: 0.8rem;
      color: var(--text-muted);
      line-height: 1.5;
      margin-bottom: 8px;
    }

    .project-mini-stack {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      color: var(--primary);
    }

    /* Skills Pill Groups */
    .skill-group {
      margin-bottom: 18px;
    }

    .skill-group-title {
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 8px;
    }

    .skill-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .pill {
      font-size: 0.8rem;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 6px;
      background: #f1f5f9;
      color: #334155;
      border: 1px solid #e2e8f0;
      transition: all 0.2s ease;
    }

    .pill-highlight {
      background: var(--primary-light);
      color: var(--primary-dark);
      border-color: #ddd6fe;
    }

    .pill-secondary {
      background: #f0f9ff;
      color: #0369a1;
      border-color: #bae6fd;
    }

    /* Sidebar Info Rows */
    .info-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .info-row {
      display: flex;
      justify-content: space-between;
      font-size: 0.85rem;
      padding-bottom: 8px;
      border-bottom: 1px dashed var(--border);
    }

    .info-row:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .info-lbl {
      color: var(--text-muted);
      font-weight: 500;
    }

    .info-val {
      font-weight: 700;
      color: var(--dark);
      text-align: right;
    }

    /* Principles List */
    .principle-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 12px;
      font-size: 0.86rem;
    }

    .principle-item svg {
      width: 16px;
      height: 16px;
      color: var(--success);
      margin-top: 3px;
      flex-shrink: 0;
    }

    /* Footer Note */
    .resume-footer {
      background: #f8fafc;
      border-top: 1px solid var(--border);
      padding: 16px 44px;
      font-size: 0.8rem;
      color: var(--text-muted);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }

    .resume-footer a {
      color: var(--primary);
      text-decoration: none;
      font-weight: 600;
    }

    .resume-footer a:hover {
      text-decoration: underline;
    }

    /* ========================================================================
       PRINT STYLES FOR CRISP, ACCURATE A4/PDF EXPORT
       ======================================================================== */
    @media print {
      body {
        background: #ffffff !important;
        padding: 0 !important;
        margin: 0 !important;
        color: #0f172a !important;
      }

      .action-bar {
        display: none !important;
      }

      .resume-wrapper {
        border: none !important;
        box-shadow: none !important;
        max-width: 100% !important;
        border-radius: 0 !important;
      }

      .resume-header {
        background: #0f172a !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        padding: 24px 30px !important;
      }

      .resume-header::after {
        background: #7c3aed !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      .metrics-bar {
        background: #f8fafc !important;
        padding: 10px 30px !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      .resume-body {
        padding: 24px 30px !important;
        gap: 28px !important;
        grid-template-columns: 280px 1fr !important;
      }

      .summary-text {
        background: #f8fafc !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        padding: 10px 14px !important;
        margin-bottom: 20px !important;
      }

      .pill {
        background: #f1f5f9 !important;
        border-color: #cbd5e1 !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      .pill-highlight {
        background: #ede9fe !important;
        color: #5b21b6 !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      .timeline-date {
        background: #ede9fe !important;
        color: #5b21b6 !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      .resume-footer {
        padding: 12px 30px !important;
      }

      a {
        text-decoration: none !important;
        color: inherit !important;
      }
    }
  </style>
</head>
<body>

  <!-- Screen Only Action Bar -->
  <div class="action-bar">
    <a href="../../index.html" class="btn btn-outline" id="btn-back">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      <span>Back to Portfolio</span>
    </a>

    <div style="display: flex; gap: 10px;">
      <a href="mailto:maahalanku36@gmail.com" class="btn btn-outline">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
          <polyline points="22,6 12,13 2,6"></polyline>
        </svg>
        <span>Send Email</span>
      </a>

      <button onclick="window.print()" class="btn btn-primary" id="btn-print">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 6 2 18 2 18 9"></polyline>
          <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
          <rect x="6" y="14" width="12" height="8"></rect>
        </svg>
        <span>Print / Save PDF</span>
      </button>
    </div>
  </div>

  <!-- Main Resume Canvas -->
  <main class="resume-wrapper">
    
    <!-- Executive Header -->
    <header class="resume-header">
      <div class="header-content">
        <div class="avatar-box">
          <img src="../images/profile/profile.webp" alt="Amit Maahal Portrait" class="avatar-img" onerror="this.src='../images/profile/profile.jpg';">
        </div>
        
        <div class="header-details">
          <div class="status-badge">
            <span class="status-dot"></span>
            <span>AVAILABLE FOR CLIENT ENGAGEMENTS</span>
          </div>
          <h1 class="name-title">Amit Maahal</h1>
          <div class="role-title">Senior Web Designer &amp; <span>WordPress Developer</span></div>

          <div class="contact-bar">
            <a href="mailto:maahalanku36@gmail.com" class="contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              <span>maahalanku36@gmail.com</span>
            </a>

            <a href="tel:+916230602387" class="contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span>+91 62306 02387</span>
            </a>

            <span class="contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>Shimla (H.P.), India</span>
            </span>

            <a href="https://www.linkedin.com/in/amit-spark-web-148476396" target="_blank" class="contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect x="2" y="9" width="4" height="12"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
              <span>LinkedIn</span>
            </a>

            <a href="https://www.instagram.com/anku_official_92_/" target="_blank" class="contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
              <span>@anku_official_92_</span>
            </a>

            <a href="https://www.facebook.com/share/1BzW8iDRsX/" target="_blank" class="contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
              <span>Facebook</span>
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Key Metrics Highlight Bar -->
    <div class="metrics-bar">
      <div class="metric-item">
        <div class="metric-icon">
